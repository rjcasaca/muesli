{
  "schemaVersion": 1,
  "id": "rcasaca.muesli",
  "name": "muesli",
  "version": "0.3.0",
  "author": "rcasaca",
  "license": "MIT",
  "description": "Recording indicator and flyout for muesli, the Granola-style meeting transcriber: live transcript, recent meetings, one-click enhance, plus settings for the STT provider, the AI backend, templates and consumption.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "muesli",
    "description": "Meeting recorder status with a flyout: live transcript, recent meetings, start/stop, enhance, open the TUI.",
    "category": "Productivity",
    "aliases": [
      "muesli",
      "meeting",
      "recorder"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollSeconds": 2,
      "hideWhenIdle": false,
      "hideWhenOff": true,
      "leftClick": "panel",
      "rightClick": "toggle",
      "middleClick": "enhance",
      "panelWidth": 420,
      "panelHeight": 640,
      "transcriptLines": 8
    },
    "schema": [
      {
        "key": "pollSeconds",
        "type": "integer",
        "label": "Poll interval (s)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 2,
        "description": "How often to ask the muesli daemon for its status."
      },
      {
        "key": "hideWhenIdle",
        "type": "boolean",
        "label": "Hide while idle",
        "defaultValue": false,
        "description": "Only show the widget when a meeting is detected or a recording is running."
      },
      {
        "key": "hideWhenOff",
        "type": "boolean",
        "label": "Hide when the daemon is not running",
        "defaultValue": true
      },
      {
        "key": "leftClick",
        "type": "enum",
        "label": "Left click",
        "options": [
          "panel",
          "toggle",
          "enhance",
          "tui",
          "settings"
        ],
        "defaultValue": "panel",
        "description": "panel = open the flyout · toggle = start/stop recording · enhance = enhance latest · tui = terminal UI · settings = open the flyout on its settings view"
      },
      {
        "key": "rightClick",
        "type": "enum",
        "label": "Right click",
        "options": [
          "panel",
          "toggle",
          "enhance",
          "tui",
          "settings"
        ],
        "defaultValue": "toggle"
      },
      {
        "key": "middleClick",
        "type": "enum",
        "label": "Middle click",
        "options": [
          "panel",
          "toggle",
          "enhance",
          "tui",
          "settings"
        ],
        "defaultValue": "enhance"
      },
      {
        "key": "panelWidth",
        "type": "integer",
        "label": "Flyout width",
        "min": 300,
        "max": 800,
        "step": 10,
        "defaultValue": 420
      },
      {
        "key": "panelHeight",
        "type": "integer",
        "label": "Flyout max height",
        "min": 300,
        "max": 1000,
        "step": 20,
        "defaultValue": 640
      },
      {
        "key": "transcriptLines",
        "type": "integer",
        "label": "Transcript lines shown",
        "min": 3,
        "max": 30,
        "step": 1,
        "defaultValue": 8
      }
    ]
  }
}
